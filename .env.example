# Wajib: Secret untuk JWT token sesi (ganti dengan string random)
JWT_SECRET="your-random-64-char-hex-secret"

# Wajib untuk production: Proteksi endpoint backup cron
CRON_SECRET="your-random-cron-secret"

# Koneksi database (Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/simplefinance?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/simplefinance?schema=public"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
